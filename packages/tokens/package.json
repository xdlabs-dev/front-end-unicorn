{
  "name": "@feu/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design tokens, mixins, and reset for HTML and Angular component sets.",
  "type": "module",
  "main": "./dist/tokens.cjs",
  "module": "./dist/tokens.js",
  "types": "./dist/index.d.ts",
  "sass": "./src/scss/index.scss",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./scss": "./src/scss/index.scss",
    "./scss/*": "./src/scss/*",
    "./css": "./dist/tokens.css",
    "./themes/light": {
      "import": "./dist/themes/light.js",
      "require": "./dist/themes/light.cjs"
    },
    "./themes/dark": {
      "import": "./dist/themes/dark.js",
      "require": "./dist/themes/dark.cjs"
    },
    "./themes/brand": {
      "import": "./dist/themes/brand.js",
      "require": "./dist/themes/brand.cjs"
    },
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/dark.css": "./dist/themes/dark.css",
    "./themes/brand.css": "./dist/themes/brand.css"
  },
  "files": ["dist", "src/scss"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "echo \"(no unit tests for tokens)\""
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "typescript": "~5.8.0",
    "vite": "^5.4.10"
  }
}
