{
  "name": "front-end-unicorn",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: shared SCSS tokens + parallel HTML and Angular 20 component libraries, consumed by Astro and Storybook with visual regression.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:apps": "pnpm -r --filter \"./apps/*\" build",
    "dev:site": "pnpm --filter @feu/site dev",
    "dev:storybook-html": "pnpm --filter @feu/storybook-html dev",
    "dev:storybook-ng": "pnpm --filter @feu/storybook-ng dev",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "storybook:build": "pnpm --filter @feu/storybook-html build && pnpm --filter @feu/storybook-ng build",
    "vr": "pnpm --filter @feu/visual-regression test",
    "clean": "pnpm -r exec rm -rf dist .angular node_modules/.vite storybook-static"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.11.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "~5.8.0"
  }
}
